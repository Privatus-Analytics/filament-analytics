{
    "name": "privatus/filament-analytics",
    "description": "Privatus Analytics dashboard widgets for Filament: visitors, pageviews, a traffic chart, top pages and top sources from cookieless website analytics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "analytics",
        "widget",
        "dashboard",
        "privacy",
        "cookieless",
        "privatus"
    ],
    "homepage": "https://privatusanalytics.com",
    "authors": [
        {
            "name": "Two Phase LLC",
            "homepage": "https://privatusanalytics.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Privatus-Analytics/filament-analytics/issues",
        "source": "https://github.com/Privatus-Analytics/filament-analytics",
        "docs": "https://privatusanalytics.com/docs/api"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "privatus/analytics": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Privatus\\FilamentAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Privatus\\FilamentAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Privatus\\FilamentAnalytics\\PrivatusAnalyticsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/build",
            "/tests",
            "/art",
            "/.github",
            "/Dockerfile",
            "/run-docker.sh",
            "/SUBMISSION.md",
            "/.php-cs-fixer.dist.php",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/composer.lock",
            "/.phpunit.cache",
            "/.php-cs-fixer.cache"
        ]
    }
}
